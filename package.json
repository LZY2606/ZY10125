{
  "name": "fem-mesh-migration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned FEA mesh correspondence and engineering-object migration with conservative load transfer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:fixtures": "tsx scripts/gen-fixtures.mts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
